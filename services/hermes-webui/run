#!/data/data/com.termux/files/usr/bin/sh
# Hermes WebUI - runit service script
# Auto-starts on device boot via runsvdir

export HERMES_WEBUI_HOST=0.0.0.0
export HERMES_WEBUI_PORT=8787
export HERMES_WEBUI_AGENT_DIR=/data/data/com.termux/files/home/.hermes/hermes-agent
export HERMES_WEBUI_PYTHON=/data/data/com.termux/files/home/.hermes/hermes-agent/venv/bin/python
export HERMES_WEBUI_STATE_DIR=/data/data/com.termux/files/home/.hermes/webui-mvp
export HERMES_WEBUI_DEFAULT_WORKSPACE=/data/data/com.termux/files/home/workspace
export HERMES_HOME=/data/data/com.termux/files/home/.hermes
export HERMES_CONFIG_PATH=/data/data/com.termux/files/home/.hermes/config.yaml
export HERMES_WEBUI_SKIP_ONBOARDING=1
export HERMES_WEBUI_BOT_NAME=Hermes
export HERMES_WEBUI_PASSWORD=hermes

mkdir -p "$HERMES_WEBUI_STATE_DIR"
mkdir -p "$HERMES_WEBUI_DEFAULT_WORKSPACE"

cd /data/data/com.termux/files/home/hermes-webui

exec /data/data/com.termux/files/home/.hermes/hermes-agent/venv/bin/python server.py 2>&1