# ============================================================
# Hermes Termux Distro - API Keys
# ============================================================
# Copy to ~/.hermes/.env, fill in YOUR keys, then:
#   chmod 600 ~/.hermes/.env

# REQUIRED — OpenRouter (free tier, 50 req/day)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_KEY_HERE

# REQUIRED — Dashboard API key (random hex, any 48 chars)
# openssl rand -hex 24
API_SERVER_KEY=

# OPTIONAL — Local models via Ollama (no key, runs at localhost:11434)
# No key needed. Just install ollama and run: ollama serve

# OPTIONAL — NVIDIA NIM vision models (free tier)
# https://build.nvidia.com/explore/discover
HERMES_NVIDIA_API_KEY=YOUR_KEY_HERE

# OPTIONAL — Direct provider keys (only if you have accounts)
# OPENAI_API_KEY=*** ANTHROPIC_API_KEY=*** # OPTIONAL — Any custom hosted endpoint
# Example: a friend's private inference server
# HERMES_CUSTOM_BASE_URL=https://myserver.example.com/v1
# HERMES_CUSTOM_API_KEY=YOUR_KEY_HERE
